# Explicit selection: mock runs instantly; ollama uses a real local model.
LLM_PROVIDER=ollama
OLLAMA_MODEL=hf.co/empero-ai/Qwen3.8-4B-Distill-GGUF:Q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120

# Vercel gateway only: the companion's HTTPS origin and shared private token.
# On the worker, set the same token to require authentication for payment APIs.
UC1_WORKER_URL=
UC1_WORKER_TOKEN=
# Optional persistent directory for worker CSV/audit files (runs remain in memory).
UC1_STORAGE_ROOT=

# Later: select LLM_PROVIDER=openai and supply your own key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# local = JSONL only; sdk = official SDK; live = direct HTTP wire client.
# Local JSONL remains available with either sending transport.
# Test the SDK without credentials with `make sdk-demo`; it starts a local sink.
DISSEQT_TRANSPORT=local
DISSEQT_API_KEY=
DISSEQT_PROJECT_ID=
DISSEQT_SERVICE_NAME=mortgage-capital-uc1
DISSEQT_APPLICATION_ID=
DISSEQT_ENDPOINT=https://api.disseqt.ai/agentic-monitoring/api/v1/traces
