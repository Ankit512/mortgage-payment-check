# Explicit selection: mock runs instantly; ollama uses a real local model.
LLM_PROVIDER=ollama
OLLAMA_MODEL=hf.co/empero-ai/Qwen3.8-4B-Distill-GGUF:Q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Later: select LLM_PROVIDER=openai and supply your own key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# Local JSONL remains available even when live delivery is enabled.
DISSEQT_TRANSPORT=local
DISSEQT_API_KEY=
DISSEQT_PROJECT_ID=
DISSEQT_SERVICE_NAME=mortgage-capital-uc1
DISSEQT_APPLICATION_ID=
DISSEQT_ENDPOINT=https://api.disseqt.ai/agentic-monitoring/api/v1/traces
